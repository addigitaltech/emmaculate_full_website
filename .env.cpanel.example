# Copy to .env on the cPanel server and fill in the values. Never commit the real .env.
APP_NAME="Emmaculate Academy"
APP_ENV=production
APP_KEY=                       # run: php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://www.yourschooldomain.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database created in cPanel > MySQL Databases (also add the user to the database with ALL PRIVILEGES)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_emmaculate
DB_USERNAME=cpaneluser_emmaculate
DB_PASSWORD=

# Shared hosting: files are faster and simpler than database drivers, and need no Redis.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
# Emails to many people are queued and sent a few at a time by the cron job (see docs/CPANEL_DEPLOYMENT.md).
QUEUE_CONNECTION=database
MAIL_BROADCAST_PER_MINUTE=60
FILESYSTEM_DISK=local

# Email (needed for "forgot password"); see docs/EMAIL_SETUP.md
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=noreply@yourschooldomain.com
MAIL_FROM_NAME="${APP_NAME}"

# First Super Admin (used once by `php artisan school:init`, then DELETE these three lines)
SCHOOL_ADMIN_NAME=
SCHOOL_ADMIN_EMAIL=
SCHOOL_ADMIN_PASSWORD=

# Payment gateway secrets stay here on the server only
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
