APP_NAME="Emmaculate Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-service.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Recommended on Render: set DB_URL to the PostgreSQL Internal Database URL.
# Alternatively, leave DB_URL empty and set DB_HOST/PORT/DATABASE/USERNAME/PASSWORD.
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=emmaculate_full_website
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Configure a real SMTP provider on Render to send password resets and notices.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_URL=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional: leave gateway secrets empty to keep online checkout unavailable.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# Docker defaults PORT to 80 locally; Render provides PORT automatically at runtime.
PORT=80
# Optional Vite build-time label.
VITE_APP_NAME="${APP_NAME}"
